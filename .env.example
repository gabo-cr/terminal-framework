# Raíz pública que contiene config/site.json, config/commands.json y config/content.json.
# HTTPS obligatorio; HTTP solo en desarrollo para localhost, 127.0.0.1 o [::1].
VITE_CONTENT_BASE_URL=https://example.com/content/
# Ruta de la aplicación: usar / para un dominio personalizado.
VITE_BASE_PATH=/terminal-framework/
